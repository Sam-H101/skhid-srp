# The private values the skhid-release skill and the release/ scripts use. Copy to
# private/release/release.env in the main checkout (never published), fill
# in, chmod 600. The skill loads it with:
#   . "$(git rev-parse --path-format=absolute --git-common-dir)/../private/release/release.env"
# (the scripts load it themselves; SKHID_RELEASE_ENV=<file> names another).

# Hosts. The live host is reached only through the jump host.
SKHID_JUMP=user@jump-host
SKHID_LIVE=user@live-host
SKHID_LIVE_DIR=/opt/srp-026g
SKHID_TEST=user@test-host
SKHID_TEST_DIR=/opt/srp-test

# What the players' ZIP is built for, and its site.
SKHID_SITE=https://example.org
SKHID_GAME_SERVER=example.org:1234
SKHID_TEST_SITE=https://test.example.org
SKHID_TEST_GAME_SERVER=test.example.org:1234
SKHID_LOCALIZATION=english

# The patches server: plain file storage (HTTP is fine; files are checked by sha256).
SKHID_PATCHES_SSH=user@patches-host
SKHID_PATCHES_DIR=/srv/skhid-patches
SKHID_PATCHES_URL=http://203.0.113.5:8090
# Optional: the Caddyfile release/setup-patches-server keeps the site block in.
# SKHID_PATCHES_CADDYFILE=/etc/caddy/Caddyfile

# Local inputs.
SKHID_GAME=/path/to/Survarium            # the original 0.26g install
SKHID_STOCK_DB=/path/to/resources.db     # the stock 0.26g resources.db (sha256 c74078be…)
