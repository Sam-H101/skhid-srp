# The private values the skhid-release skill uses. Copy to
# private/release/release.env in the main checkout (never published, see
# .gitignore), fill in, chmod 600. The skill loads it with:
#   . "$(git rev-parse --path-format=absolute --git-common-dir)/../private/release/release.env"
# Shell syntax; no secrets other than paths and addresses belong here (the
# live .env stays on the live host).

# Hosts. The live host is reached only through the jump host, which holds
# the key for it.
SKHID_JUMP=user@jump-host
SKHID_LIVE=user@live-host
SKHID_LIVE_DIR=/opt/srp-026g          # the live server's copied source tree
SKHID_TEST=user@test-host
SKHID_TEST_DIR=/opt/srp-test

# What the players' ZIP is built for (make_client_026g.py --server=, --localization=)
# and the site it asks for updates.
SKHID_SITE=https://example.org
SKHID_GAME_SERVER=example.org:1234
SKHID_TEST_SITE=https://test.example.org
SKHID_TEST_GAME_SERVER=test.example.org:1234
SKHID_LOCALIZATION=english

# Local inputs of a build.
SKHID_GAME=/path/to/Survarium            # the original 0.26g install (game/binaries/x86/survarium.exe, the launcher)
SKHID_STOCK_DB=/path/to/resources.db     # the stock 0.26g resources.db (sha256 c74078be…)
SKHID_PORTER=/path/to/resource-porter    # checkout of resource-porter (packs, pack release)
SKHID_PACKS=/path/to/packs               # the content packs releases are made from
SKHID_SIGNING_KEY=/path/to/key.pem       # the release signing key (private half; mode 600)
