#!/usr/bin/env bash
# usage: release/build-server-db [--out <file>]
#
# Builds the game server's server-game-data.db from the stock resources.db
# ($SKHID_STOCK_DB) and every patch published on the patches server:
#   1. lists resources.db.patch_<n> in $SKHID_PATCHES_DIR (ssh, read only);
#   2. downloads each from $SKHID_PATCHES_URL/<name>: each must answer 200
#      with the sha256 the file has on the server;
#   3. srp-game-data build --db $SKHID_STOCK_DB --patch-url $SKHID_PATCHES_URL
#      --patch <each> --out <file>, then srp-game-data info <file>;
#   4. prints what the server's /patches will offer the players' updater.
#
#   --out <file>   default ./server-game-data.db; never overwritten
#
# Run it for every release, content or not. Next: release/deploy.
. "$(dirname "$0")/lib.sh"

out=server-game-data.db
while (($#)); do
    case $1 in
    -h | --help) usage ;;
    --out) (($# >= 2)) || usage 1; out=$2; shift 2 ;;
    *) die "unknown argument $1 (--help)" ;;
    esac
done
[[ ! -e $out ]] || die "$out: already there; never overwritten"
need_cmds ssh curl sha256sum
load_env SKHID_PATCHES_SSH SKHID_PATCHES_DIR SKHID_PATCHES_URL SKHID_STOCK_DB
[[ -f $SKHID_STOCK_DB ]] || die "SKHID_STOCK_DB: $SKHID_STOCK_DB: no such file"
bin=$(game_data_bin)

# `<sha256>  <name>` of every file there called resources.db.patch_*.
listing=$(on_patches "cd $(q "$SKHID_PATCHES_DIR") && for f in resources.db.patch_*; do if test -f \"\$f\"; then sha256sum \"\$f\"; fi; done")
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
args=()
while read -r sha name; do
    [[ -n $name ]] || continue
    if ! patch_number "$name" >/dev/null; then
        say "ignored on the patches server: $name (not a name the game mounts)"
        continue
    fi
    url=${SKHID_PATCHES_URL%/}/$name
    status=$(http_get "$url" "$work/$name")
    [[ $status == 200 ]] || die "GET $url answered $status, not 200"
    got=$(sha256_of "$work/$name")
    [[ $got == "$sha" ]] || die "GET $url gave sha256 $got; the file on the server has $sha"
    say "$name: 200, $(size_of "$work/$name") bytes, sha256 $sha"
    args+=(--patch "$work/$name")
done <<<"$listing"
((${#args[@]})) || say "no patch on the patches server"

"$bin" build --db "$SKHID_STOCK_DB" --patch-url "$SKHID_PATCHES_URL" "${args[@]}" --out "$out"
say
info=$("$bin" info "$out")
say "$info"
say
say "/patches will offer:"
offered=$(sed -n 's/^  resources\.db\.\(patch_[0-9]*\) [0-9]* bytes sha256 \([0-9a-f]*\) url \(.*\)$/  \1 sha256 \2 url \3/p' <<<"$info")
if [[ -n $offered ]]; then say "$offered"; else say "  nothing ({}): the updater deletes every patch file of a game"; fi
say "$out: sha256 $(sha256_of "$out")"
say "next: release/deploy --server-data $out ..."
