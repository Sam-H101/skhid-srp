#!/usr/bin/env bash
# usage: release/deploy --zip <zip> --server-data <db> --revision <n> [--label <word>] [--dry-run]
#
# Puts a release on the live host ($SKHID_LIVE through $SKHID_JUMP, in
# $SKHID_LIVE_DIR), in the maintenance window (skill step 7):
#   1. checks here: the ZIP's exe says patch revision <n>, the server data
#      reads (srp-game-data info) and offers no patch above <n>;
#   2. archives the current ZIP and server data in old-downloads/
#      (<name>-<UTC YYYYMMDD-HHMM>-<label>);
#   3. uploads each to download/<name>.tmp, checks its sha256 on the host,
#      chmod 644, mv into place;
#   4. sets SRP_MIN_PATCH_REVISION=<n> in .env (that one line; the file is
#      never printed);
#   5. docker compose up -d --no-deps srp26 (says how many matches run);
#   6. checks $SKHID_SITE/patches (what the server data offers) and
#      $SKHID_SITE/api/client-files (the ZIP's sha256 and size).
# Every write on the live host asks y/N first, showing the command; a no
# stops there. Reads (ls, sha256sum, grep of that one setting) just run.
#
#   --label <word>  names the archived files (default before-r<n>)
#   --dry-run       prints every command, runs none on the live host
#
# Server code changed? Build the image first (skill step 7.5); this script
# only restarts.
. "$(dirname "$0")/lib.sh"

zip='' data='' revision='' label=''
while (($#)); do
    case $1 in
    -h | --help) usage ;;
    --zip) (($# >= 2)) || usage 1; zip=$2; shift 2 ;;
    --server-data) (($# >= 2)) || usage 1; data=$2; shift 2 ;;
    --revision) (($# >= 2)) || usage 1; revision=$2; shift 2 ;;
    --label) (($# >= 2)) || usage 1; label=$2; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    *) die "unknown argument $1 (--help)" ;;
    esac
done
[[ -n $zip && -n $data && -n $revision ]] || usage 1
is_revision "$revision" || die "$revision: a revision is a number from 1 to 255"
label=${label:-before-r$revision}
[[ $label =~ ^[A-Za-z0-9._-]+$ ]] || die "$label: a label is letters, digits, . _ -"
[[ -f $zip ]] || die "$zip: no such file"
[[ -f $data ]] || die "$data: no such file"
need_cmds ssh curl sha256sum jq od
load_env SKHID_JUMP SKHID_LIVE SKHID_LIVE_DIR SKHID_SITE

# 1. Here.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
zip_extract "$zip" game/binaries/x86/survarium_skhid.exe "$work/exe" ||
    die "$zip has no game/binaries/x86/survarium_skhid.exe"
zip_revision=$(exe_revision "$work/exe")
[[ $zip_revision == "$revision" ]] || die "$zip: its exe says patch revision $zip_revision, not $revision"
bin=$(game_data_bin)
info=$("$bin" info "$data") || die "$data: srp-game-data info refused it"
# `patch_<n> <sha256> <url>` of each patch the data offers.
offered=$(sed -n 's/^  resources\.db\.\(patch_[0-9]*\) [0-9]* bytes sha256 \([0-9a-f]*\) url \(.*\)$/\1 \2 \3/p' <<<"$info")
while read -r key _; do
    [[ -n $key ]] || continue
    ((${key#patch_} <= revision)) || die "$data offers $key, above revision $revision"
done <<<"$offered"
zip_sha=$(sha256_of "$zip") zip_size=$(size_of "$zip") data_sha=$(sha256_of "$data")
say "ZIP: $zip, $zip_size bytes, sha256 $zip_sha, patch revision $revision"
say "server data: $data, sha256 $data_sha; /patches will offer:"
while read -r line; do
    if [[ -n $line ]]; then say "  $line"; fi
done <<<"$offered"
if [[ -z $offered ]]; then say "  nothing ({})"; fi
expected=$(jq -cnS --arg list "$offered" '$list | split("\n") | map(select(length > 0) | split(" ")
    | {key: .[0], value: {sha256: .[1], url: .[2]}}) | from_entries')

D=$(q "$SKHID_LIVE_DIR")
ZIP_NAME=Survarium-0.26g-srp-files.zip
DATA_NAME=server-game-data.db

# What is there now: the two files, the setting's line(s), the matches.
say
say "on the live host now:"
read_live "cd $D && ls -l download/$ZIP_NAME download/$DATA_NAME 2>&1; grep -E '^SRP_MIN_PATCH_REVISION=' .env || echo 'SRP_MIN_PATCH_REVISION: not in .env'"
if ((!DRY_RUN)); then
    lines=$(on_live "cd $D && grep -c '^SRP_MIN_PATCH_REVISION=' .env || true")
    ((lines <= 1)) || die ".env has SRP_MIN_PATCH_REVISION $lines times; fix it by hand first"
fi

# 2. The archive.
stamp=$(date -u +%Y%m%d-%H%M)
old_zip=old-downloads/${ZIP_NAME%.zip}-$stamp-$label.zip
old_data=old-downloads/${DATA_NAME%.db}-$stamp-$label.db
write_on live "cd $D && mkdir -p old-downloads && if test -e download/$ZIP_NAME; then cp -p download/$ZIP_NAME $old_zip; fi && if test -e download/$DATA_NAME; then cp -p download/$DATA_NAME $old_data; fi && ls -l old-downloads | tail -n 4"

# 3. The files.
put() {
    local file=$1 name=$2 sha=$3 there
    write_on live "cat > $D/download/$name.tmp" "$file"
    if ((!DRY_RUN)); then
        there=$(on_live "sha256sum < $D/download/$name.tmp")
        [[ ${there%% *} == "$sha" ]] || die "download/$name.tmp has sha256 ${there%% *} on the host, not $sha; left as .tmp"
        say "download/$name.tmp: sha256 $sha, as here"
    else
        say "[dry run] then: sha256sum < $D/download/$name.tmp must be $sha"
    fi
    write_on live "cd $D/download && chmod 644 $name.tmp && mv $name.tmp $name"
}
put "$data" "$DATA_NAME" "$data_sha"
put "$zip" "$ZIP_NAME" "$zip_sha"

# 4. The setting.
write_on live "cd $D && if grep -q '^SRP_MIN_PATCH_REVISION=' .env; then sed -i 's/^SRP_MIN_PATCH_REVISION=.*/SRP_MIN_PATCH_REVISION=$revision/' .env; else { test -z \"\$(tail -c 1 .env)\" || echo; echo SRP_MIN_PATCH_REVISION=$revision; } >> .env; fi && grep -E '^SRP_MIN_PATCH_REVISION=' .env"

# 5. The restart.
stats=$(curl -sS --max-time 20 "${SKHID_SITE%/}/api/stats" || true)
matches=$(jq -r '.matches // "unknown"' <<<"$stats" 2>/dev/null || echo unknown)
say
say "matches running now: $matches (the restart ends every one)"
write_on live "cd $D && docker compose up -d --no-deps srp26"

# 6. The checks.
if ((DRY_RUN)); then
    say "[dry run] then: GET ${SKHID_SITE%/}/patches must be $expected"
    say "[dry run] and GET ${SKHID_SITE%/}/api/client-files must say sha256 $zip_sha, size $zip_size"
    say "[dry run] rollback: $old_zip and $old_data back into download/, SRP_MIN_PATCH_REVISION back, up -d"
    exit 0
fi
read_live "cd $D && docker compose ps srp26 && docker compose logs --tail=20 srp26"
patches=
for _ in $(seq 30); do
    status=$(http_get "${SKHID_SITE%/}/patches" "$work/patches")
    [[ $status == 200 ]] && { patches=$(jq -cS . "$work/patches" 2>/dev/null || true); break; }
    sleep 2
done
[[ -n $patches ]] || die "GET ${SKHID_SITE%/}/patches gave no list (status $status)"
[[ $patches == "$expected" ]] || die "/patches is $patches, not $expected"
say "/patches: $patches, as the server data says"
status=$(http_get "${SKHID_SITE%/}/api/client-files" "$work/client-files")
[[ $status == 200 ]] || die "GET /api/client-files answered $status"
if ! grep -qx "sha256 $zip_sha" "$work/client-files" || ! grep -qx "size $zip_size" "$work/client-files"; then
    die "/api/client-files is not the new ZIP: $(tr '\n' ' ' <"$work/client-files")"
fi
say "/api/client-files: the new ZIP (sha256 $zip_sha, $zip_size bytes)"
say
say "deployed revision $revision. Archived: $SKHID_LIVE_DIR/$old_zip, $SKHID_LIVE_DIR/$old_data"
say "Now: a game updates, downloads the patches, signs in; an old game is refused (skill step 8)."
