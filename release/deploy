#!/usr/bin/env bash
# usage: release/deploy --zip <zip> --server-data <db> --revision <n> [--label <word>] [--dry-run]
#
# Puts a release on the live host ($SKHID_LIVE through $SKHID_JUMP, in
# $SKHID_LIVE_DIR), in a maintenance window planned by hand. release/release.sh
# does the same and more (maintenance, staging, the build) in one run; this is
# the step on its own:
#   1. checks here: the ZIP's exe says patch revision <n>, the server data
#      reads (srp-game-data info) and offers no patch above <n>;
#   2. archives the current ZIP and server data in old-downloads/
#      (<name>-<UTC YYYYMMDD-HHMM>-<label>);
#   3. uploads each to download/<name>.tmp, checks its sha256 on the host,
#      chmod 644, mv into place;
#   4. sets SRP_MIN_PATCH_REVISION=<n> in .env (that one line; the file is
#      never printed);
#   5. docker compose up -d --no-deps --force-recreate srp26 (says how many
#      matches run);
#   6. checks $SKHID_SITE/patches (what the server data offers) and
#      $SKHID_SITE/api/client-files (the ZIP's sha256 and size).
# Every write on the live host asks y/N first, showing the command; a no
# stops there. Reads (ls, sha256sum, grep of that one setting) just run.
#
#   --label <word>  names the archived files (default before-r<n>)
#   --dry-run       prints every command, runs none on the live host
#
# Server code changed? Build the image first; this script only restarts.
. "$(dirname "$0")/lib.sh"

zip='' data='' revision='' label=''
while (($#)); do
    case $1 in
    -h | --help) usage ;;
    --zip) (($# >= 2)) || usage 1; zip=$2; shift 2 ;;
    --server-data) (($# >= 2)) || usage 1; data=$2; shift 2 ;;
    --revision) (($# >= 2)) || usage 1; revision=$2; shift 2 ;;
    --label) (($# >= 2)) || usage 1; label=$2; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    *) die "unknown argument $1 (--help)" ;;
    esac
done
[[ -n $zip && -n $data && -n $revision ]] || usage 1
is_revision "$revision" || die "$revision: a revision is a number from 1 to 255"
label=${label:-before-r$revision}
[[ $label =~ ^[A-Za-z0-9._-]+$ ]] || die "$label: a label is letters, digits, . _ -"
[[ -f $zip ]] || die "$zip: no such file"
[[ -f $data ]] || die "$data: no such file"
need_cmds ssh curl sha256sum jq od
use_target live

# 1. Here.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
check_release_files "$zip" "$data" "$revision" "$work"
say "ZIP: $zip, $ZIP_SIZE bytes, sha256 $ZIP_SHA, patch revision $revision"
say "server data: $data, sha256 $DATA_SHA; /patches will offer:"
say_offered

D=$(q "$TARGET_DIR")

# What is there now: the two files, the setting's line(s), the matches.
say
say "on the live host now:"
read_live "cd $D && ls -l download/$ZIP_NAME download/$DATA_NAME 2>&1; grep -E '^SRP_MIN_PATCH_REVISION=' .env || echo 'SRP_MIN_PATCH_REVISION: not in .env'"
if ((!DRY_RUN)); then current_min_revision >/dev/null; fi

# 2. The archive.
archive_names "$(date -u +%Y%m%d-%H%M)" "$label"
write_on live "$(archive_command)"

# 3. The files.
put() {
    stage_upload "$1" "$2" "$3"
    write_on live "cd $D/download && mv $2.tmp $2"
}
put "$data" "$DATA_NAME" "$DATA_SHA"
put "$zip" "$ZIP_NAME" "$ZIP_SHA"

# 4. The setting.
write_on live "$(min_revision_command "$revision")"

# 5. The restart.
stats=$(curl -sS --max-time 20 "$TARGET_SITE/api/stats" || true)
matches=$(jq -r '.matches // "unknown"' <<<"$stats" 2>/dev/null || echo unknown)
say
say "matches running now: $matches (the restart ends every one)"
write_on live "$(restart_command)"

# 6. The checks.
if ((DRY_RUN)); then
    say "[dry run] then: GET $TARGET_SITE/patches must be $EXPECTED"
    say "[dry run] and GET $TARGET_SITE/api/client-files must say sha256 $ZIP_SHA, size $ZIP_SIZE"
    say "[dry run] rollback: $OLD_ZIP and $OLD_DATA back into download/, SRP_MIN_PATCH_REVISION back, up -d"
    exit 0
fi
read_live "cd $D && $TARGET_COMPOSE ps srp26 && $TARGET_COMPOSE logs --tail=20 srp26"
check_served "$work"
say
say "deployed revision $revision. Archived: $TARGET_DIR/$OLD_ZIP, $TARGET_DIR/$OLD_DATA"
say "Now: a game updates, downloads the patches, signs in; an old game is refused."
