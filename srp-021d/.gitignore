# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Per-server log files written by the unified `srp` binary
logs/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# The accounts database and its backups (SRP_DATA_DIR)
/data/

# Local copies of the players' download
/download/

# Python caches of the scripts
__pycache__/
